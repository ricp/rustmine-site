# Serve only the established public static site from the repository root.
# Keep repository metadata, scripts, docs and deployment controls out of uploads.
/*
!/index.html
!/site.css
!/site.js
!/admin-videos.css
!/admin-videos.js
!/analytics.js
!/legacy-fragments.js
!/apple-touch-icon.png
!/favicon-16.png
!/favicon-32.png
!/favicon-48.png
!/favicon-192.png
!/favicon-512.png
!/favicon.ico
!/favicon.svg
!/site.webmanifest
!/sitemap.xml
!/robots.txt
!/social-card.png
!/social-card-2026-10-20.png
!/assets/
!/data/
/data/*
!/data/commit-history.json
!/design/
/design/*
!/design/index.html
!/journal/
/journal/*
!/journal/index.html
!/method/
/method/*
!/method/index.html
!/privacy/
/privacy/*
!/privacy/index.html
!/progress/
/progress/*
!/progress/index.html
!/screens/
/screens/*
!/screens/index.html


